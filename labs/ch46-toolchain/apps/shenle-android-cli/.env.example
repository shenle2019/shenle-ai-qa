# shenle-android-cli AI 分析配置示例
#
# 复制为 .env 后填入实际值即可启用采集时的多模态 AI 描述功能。
# 没配或缺关键字段时，采集照常进行，AI 字段在 JSON 里写为 null。
#
# 命名约定：用 ANDROID_AI_* 前缀（跟 shenle-web-cli 的 WEB_AUTOMATION_AI_*
# 同构），多工具共用一份 .env 时不撞名。

# OpenAI 兼容 API key（必填）
ANDROID_AI_API_KEY=sk-your-key-here

# API 端点（可选，默认 OpenAI 官方）
# 兼容服务示例：
#   OpenAI 官方：    https://api.openai.com/v1
#   火山豆包：      https://ark.cn-beijing.volces.com/api/v3
#   智谱 BigModel：  https://open.bigmodel.cn/api/paas/v4
#   月之暗面：      https://api.moonshot.cn/v1
#   本地 ollama：    http://localhost:11434/v1
ANDROID_AI_BASE_URL=https://api.openai.com/v1

# 多模态模型名（必填，需支持图像输入）
ANDROID_AI_MODEL=gpt-4o

# 单次 AI 调用超时（秒，可选，默认 30）
# ANDROID_AI_TIMEOUT=30
