      "body": "\n\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n<head>\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\"/>\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\"/>\n    <title>小说排行榜_读书屋</title>\n    <link rel=\"stylesheet\" href=\"/css/base.css?v=1\"/>\n    <meta name=\"keywords\" content=\"小说排行榜,热门小说榜,小说排行榜完结版,完结小说排行榜,完本小说排行榜,最新小说排行榜,网络小说排行榜,排行榜,点击榜,新书榜,推荐榜\" /><meta name=\"description\" content=\"最新热门网络小说排行榜,包含各类热门小说榜,小说排行榜上都是受用户喜爱的小说作品,精彩尽在读书屋。\" />\n    <link rel=\"stylesheet\" href=\"/css/main.css\" /><link rel=\"stylesheet\" href=\"/css/book.css\" />\n    \n    <script>\n        var _hmt = _hmt || [];\n        (function() {\n            var hm = document.createElement(\"script\");\n            hm.src = \"https://hm.baidu.com/hm.js?ecc8b50a3122e6d5e09be7a9e5383e07\";\n            var s = document.getElementsByTagName(\"script\")[0];\n            s.parentNode.insertBefore(hm, s);\n        })();\n    </script>\n\n</head>\n<body>\n\n<div class=\"header\">\n    <div class=\"topBar\" style=\"display: none\">\n        <div class=\"box_center cf\">\n            <div class=\"top_l\">\n                <a href=\"/\" class=\"on\">读书屋</a><i class=\"line\">|</i><a\n                    href=\"/?m=2\">手机女生版</a><i class=\"line\">|</i><a\n                    href=\"/?m=1\">手机男生版</a><i class=\"line\">|</i><a\n                    href=\"/\">客户端下载</a>\n            </div>\n            <div class=\"top_r\">\n                <div class=\"top_nearread\">\n                    <a href=\"javascript:void(0);\" class=\"nearread\" id=\"headerUserHistoryBtn\">最近阅读<i\n                            class=\"icon_down\"></i></a>\n                    <div class=\"book_record\" style=\"display:none\" id=\"headerUserHistory\">\n                    </div>\n                </div>\n                <span>\n              