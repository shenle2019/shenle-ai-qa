# shenle-api-cli 的 AI 配置（自然语言提取 / 断言需要）
# 复制本文件到项目根 .env，按需修改

# 1. 必需：API key（OpenAI 兼容协议）
API_AUTOMATION_AI_API_KEY=sk-your-key-here

# 2. 必需：LLM 网关 base_url（OpenAI 兼容协议）
API_AUTOMATION_AI_BASE_URL=http://your-llm-gateway/v1

# 3. 必需：模型名（必须支持 response_format: json_object）
API_AUTOMATION_AI_MODEL=your-model-name

# 注意：
# - 真实环境变量优先于本文件
# - 改完直接生效，无需重启任何 daemon
# - 纯 JSONPath 模式（extract --field "$.x.y"）不需要本配置
